{
    "files": {
        "includes": [
            "**",
            "!**/node_modules/**/*",
            "!**/dist/**/*",
            "!**/bundle/**/*",
            "!**/coverage/**/*"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "formatWithErrors": true,
        "includes": [
            "**",
            "!**/node_modules/**/*",
            "!**/dist/**/*",
            "!**/bundle/**/*",
            "!**/coverage/**/*"
        ]
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "semicolons": "always"
        }
    },
    "json": {
        "formatter": {
            "enabled": true
        }
    },
    "linter": {
        "rules": {
            "suspicious": {
                "noExplicitAny": "off",
                "noImplicitAnyLet": "off",
                "noDocumentCookie": "off"
            },
            "correctness": {
                "noUnusedImports": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts", "**/*.harness.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}
