    "repository": {
        "type": "git",
        "url": "git+https://github.com/neuralfog/elemix.git",
        "directory": "packages/elemix-ssr"
    },
    "type": "module",
    "files": [
        "./src/**/*",
        "CHANGELOG.md"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./component": "./src/component.ts",
        "./build": "./src/build/index.ts"
    },
    "scripts": {
        "build": "tsc --noEmit",
        "lint": "tsc --noEmit && biome format && biome lint --error-on-warnings",
        "lint:fix": "biome format --write . && biome lint --write . --error-on-warnings && tsc --noEmit"
    },
    "dependencies": {
        "@neuralfog/elemix": "workspace:*",
        "sass": "1.108.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@neuralfog/ts-config": "0.1.2",
        "@types/bun": "1.4.4",
        "@types/node": "26.6.6",
        "typescript": "7.0.2"
    }
}
