    },
    "dependencies": {
        "@neuralfog/elemix": "workspace:*",
        "sass": "1.103.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.3",
        "@neuralfog/biome-config": "0.1.2",
        "@neuralfog/ts-config": "0.1.2",
        "@types/bun": "1.4.0",
        "@types/node": "26.1.1",
        "typescript": "7.0.2"
    }
}
