    "license": "MIT",
    "author": "brownhounds",
    "type": "module",
    "files": [
        "./src/**/*"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./navigation": "./src/navigation/index.ts",
        "./navigation/NavLink": "./src/navigation/NavLink.ts",
        "./component": "./src/component.ts",
        "./build": "./src/build/index.ts"
    },
    "scripts": {
        "build": "tsc --noEmit",
        "lint": "tsc --noEmit && biome format && biome lint --error-on-warnings",
