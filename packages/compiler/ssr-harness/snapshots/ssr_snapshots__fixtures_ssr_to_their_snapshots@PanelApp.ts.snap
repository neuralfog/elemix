return [`<${this.$$__tag ?? 'panel-app'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><div class="panel">`, ($__ssrTpl(`<h2>`, $__ssrText(this.state.title), `</h2>`)), ` `, ($__ssrTpl(`<p class="stat">`, $__ssrText(this.state.count), ` open</p>`)), ` <button>add</button><button>rename</button></div></template></${this.$$__tag ?? 'panel-app'}>`];
}


    state = $__state<State>({
        title: 'Inbox',
        count: 3,
    });

    add = (): void => {
        this.state.count++;
    };

    rename = (): void => {
        this.state.title = this.state.title === 'Inbox' ? 'Archive' : 'Inbox';
    };

    
    
    
}
