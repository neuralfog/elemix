                    : $__ssrTpl(`<div class="empty">child unmounted</div>`)), `</div><div class="buttons"><button>`, $__ssrText(this.state.mounted ? 'Unmount' : 'Mount'), `</button><button${$__ssrAttr('disabled', !this.state.mounted)}>Update child</button><button class="ghost">Clear log</button></div>`, $__ssrChild('log-view', {}), `</template></${this.$$__tag ?? 'lifecycle-app'}>`];
}


    state = $__state<State>({ mounted: false, tick: 0 });

    toggleMount = (): void => {
        this.state.mounted = !this.state.mounted;
    };

    update = (): void => {
        this.state.tick++;
    };

    clear = (): void => {
        clearLog();
    };

    
}
$__defineComponent('lifecycle-app', LifecycleApp);
LifecycleApp.prototype.$$__tag = 'lifecycle-app';
LifecycleApp.$$__propSafe = true;
