return [`<${this.$$__tag ?? 'mx-attr-hole'}><template shadowrootmode="open" shadowrootserializable=""><div class="wrap"><div class="box" data-static="s"${$__ssrAttr('data-tag', this.state.tag)}${$__ssrAttr('data-n', this.state.n)}${$__ssrAttr('aria-hidden', this.state.flag)}><span class="label">box</span></div><button id="clear-tag">clear</button><button id="set-tag">set</button><button id="toggle-flag">flag</button><button id="bump">bump</button></div></template></${this.$$__tag ?? 'mx-attr-hole'}>`];
