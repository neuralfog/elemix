import { $__ssrText } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

type State = { count: number };

const css = `
    :host {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px;
        font-family: system-ui, sans-serif;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }
    button {
        font: inherit;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 8px;
        background: #6366f1;
        color: white;
        cursor: pointer;
    }
    button:hover { background: #4f46e5; }
    .count { font-weight: 700; min-width: 2ch; text-align: center; color: #1e293b; }
`;

export class ProofDestructuring extends Component {
$$__ssr(): unknown[] {
const { inc, dec } = this;
return [`<${this.$$__tag ?? 'proof-destructuring'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><div><button class="dec">−</button><span class="count">`, $__ssrText(this.state.count), `</span><button class="inc">+</button></div></template></${this.$$__tag ?? 'proof-destructuring'}>`];
}

    state = $__state<State>({ count: 0 });

    inc = (): void => {
        this.state.count++;
    };

    dec = (): void => {
        this.state.count--;
    };

    
}
$__defineComponent('proof-destructuring', ProofDestructuring);
ProofDestructuring.prototype.$$__tag = 'proof-destructuring';
ProofDestructuring.$$__propSafe = true;
