import { $__defineComponent } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

import { counter } from './SignalStore';

const css = `
    :host { display: block; font-family: system-ui, sans-serif; }
    .buttons { display: flex; justify-content: center; gap: 10px; }
    button {
        font: inherit;
        font-size: 16px;
        min-width: 48px;
        padding: 10px 18px;
        border: none;
        border-radius: 10px;
        background: #6366f1;
        color: white;
        cursor: pointer;
    }
    button:hover { background: #4f46e5; }
`;

export class SignalButtons extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'signal-buttons'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><div class="buttons"><button>−</button><button>Reset</button><button>+</button></div></template></${this.$$__tag ?? 'signal-buttons'}>`];
}


    dec = (): void => {
        counter.count--;
    };

    reset = (): void => {
        counter.count = 0;
    };

    inc = (): void => {
        counter.count++;
    };

    
}
$__defineComponent('signal-buttons', SignalButtons);
