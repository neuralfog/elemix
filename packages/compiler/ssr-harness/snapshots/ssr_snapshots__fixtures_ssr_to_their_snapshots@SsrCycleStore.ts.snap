import { $__moduleState } from '@neuralfog/elemix/ssr-runtime';
export type CycleEntry = { id: number; event: string };

export const cycle = $__moduleState<{ entries: CycleEntry[] }>(() => ({ entries: [] }));

let seq = 0;

export const record = (event: string): void => {
    seq++;
    cycle.entries.push({ id: seq, event });
};
