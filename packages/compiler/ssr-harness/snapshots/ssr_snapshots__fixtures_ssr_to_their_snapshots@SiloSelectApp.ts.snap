import { $__ssrText, $__ssrAttr, $__ssrClass, $__ssrTpl, $__ssrRepeat } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent } from '@neuralfog/elemix/runtime';
import { Component, silo } from '@neuralfog/elemix';
import type { Silo } from '@neuralfog/elemix/types';

type Row = { id: number; label: Silo<string> };

let nextId = 1;

const makeRow = (label: string): Row => ({ id: nextId++, label: silo(label) });

const seed = (): Row[] => [
    makeRow('alpha'),
    makeRow('beta'),
    makeRow('gamma'),
];

const css = `
    :host { display: block; font-family: system-ui, sans-serif; }
    ul { list-style: none; margin: 0; padding: 0; }
    li { cursor: pointer; }
    li.danger { color: #b91c1c; font-weight: 700; }
    button { font: inherit; cursor: pointer; }
`;

export class SiloSelectApp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'silo-select-app'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><span class="sel">`, $__ssrText(this.selected.value), `</span><div class="controls"><button class="clear">clear</button><button class="bump">bump</button><button class="append">append</button></div><ul class="rows">`, ($__ssrRepeat(
                this.rows.value,
                (row) =>
                    $__ssrTpl(`<li${$__ssrClass(row.id === this.selected.value ? 'row danger' : 'row')}${$__ssrAttr('data-id', row.id)}><span class="rid">`, $__ssrText(row.id), `</span><span class="rlabel">`, $__ssrText(row.label.value), `</span></li>`),
                (row) => row.id,
            )), `</ul></template></${this.$$__tag ?? 'silo-select-app'}>`];
}


    rows = silo<Row[]>(seed());
    selected = silo<number>(-1);

    select = (e: Event): void => {
        const li = (e.target as HTMLElement).closest('li');
        const id = li?.dataset.id;
        if (id) this.selected.value = Number(id);
    };

    clearSelection = (): void => {
        this.selected.value = -1;
    };

    bumpFirst = (): void => {
        const first = this.rows.value[0];
        if (first) first.label.value += '!';
    };

    append = (): void => {
        this.rows.value.push(makeRow('delta'));
        this.rows.trigger();
    };

    
}
$__defineComponent('silo-select-app', SiloSelectApp);
SiloSelectApp.prototype.$$__tag = 'silo-select-app';
SiloSelectApp.$$__propSafe = true;
