import { $__ssrChild, $__ssrTpl, $__ssrRepeat } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

import './MxCounterChild';

type Item = { id: number; label: string };
type State = { items: Item[] };

export class MxListOfComponents extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'mx-list-of-components'}><template shadowrootmode="open" shadowrootserializable=""><div class="wrap"><div class="list">`, ($__ssrRepeat(
                    this.state.items,
                    (it) =>
                        $__ssrTpl($__ssrChild('mx-counter-child', {label: (it.label)})),
                    (it) => it.id,
                )), `</div><button id="reverse">reverse</button><button id="swap">swap</button><button id="remove-middle">remove</button><button id="clear">clear</button></div></template></${this.$$__tag ?? 'mx-list-of-components'}>`];
}

    state = $__state<State>({
        items: [
            { id: 1, label: 'x' },
            { id: 2, label: 'y' },
            { id: 3, label: 'z' },
        ],
    });

    reverse = (): void => {
        this.state.items.reverse();
    };

    swapEnds = (): void => {
        const list = this.state.items;
        if (list.length < 2) return;
        const first = list[0];
        list[0] = list[list.length - 1];
        list[list.length - 1] = first;
    };

    removeMiddle = (): void => {
        const list = this.state.items;
        if (list.length === 0) return;
        list.splice(Math.floor(list.length / 2), 1);
    };

    clear = (): void => {
        this.state.items = [];
    };

    
}
$__defineComponent('mx-list-of-components', MxListOfComponents);
MxListOfComponents.prototype.$$__tag = 'mx-list-of-components';
MxListOfComponents.$$__propSafe = true;
