import { $__ssrText, $__ssrTpl, $__ssrRepeat } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component, raw } from '@neuralfog/elemix';

class Stopwatch {
    #ticks = 0;

    tick(): void {
        this.#ticks++;
    }

    get ticks(): number {
        return this.#ticks;
    }
}

type Row = { id: string; label: string };

type State = {
    sw: Stopwatch;
    count: number;
    rows: Row[];
};

const css = `
    :host { display: block; font-family: system-ui, sans-serif; }
    ul { list-style: none; margin: 0; padding: 0; }
    button { font: inherit; cursor: pointer; }
`;

export class RawApp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'raw-app'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><span class="ticks">`, $__ssrText(this.state.sw.ticks), `</span><span class="count">`, $__ssrText(this.state.count), `</span><div class="controls"><button class="tick">tick</button><button class="refresh">refresh</button><button class="inc">inc</button><button class="add-row">row</button></div><ul class="rows">`, ($__ssrRepeat(
                this.state.rows,
                (row) =>
                    $__ssrTpl(`<li class="row"><span class="rid">`, $__ssrText(row.id), `</span><span class="rlabel">`, $__ssrText(row.label), `</span></li>`),
                (row) => row.id,
            )), `</ul></template></${this.$$__tag ?? 'raw-app'}>`];
}


    state = $__state<State>({
        sw: raw(new Stopwatch()),
        count: 0,
        rows: [{ id: 'a', label: 'A' }],
    });

    tickRaw = (): void => {
        this.state.sw.tick();
    };

    refresh = (): void => {
        this.render();
    };

    inc = (): void => {
        this.state.count++;
    };

    addRow = (): void => {
        this.state.rows.push({ id: 'b', label: 'B' });
    };

    
}
$__defineComponent('raw-app', RawApp);
RawApp.prototype.$$__tag = 'raw-app';
RawApp.$$__propSafe = true;
