import { $__ssrText } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

type State = { x: number; runs: number };

export class MxRenderEffect extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'mx-render-effect'}><template shadowrootmode="open" shadowrootserializable=""><span class="runs">`, $__ssrText(this.state.runs), `</span><span class="label">`, $__ssrText(this.label), `</span><button class="bump">bump</button><button class="paint">paint</button></template></${this.$$__tag ?? 'mx-render-effect'}>`];
}

