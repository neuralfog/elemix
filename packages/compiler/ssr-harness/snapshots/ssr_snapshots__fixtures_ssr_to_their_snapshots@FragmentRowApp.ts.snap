import { $__ssrText, $__ssrTpl, $__ssrRepeat } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

type Group = { id: string; items: string[] };

export class FragmentRowApp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'fragment-row-app'}><template shadowrootmode="open" shadowrootserializable=""><div class="rows">`, ($__ssrRepeat(
                this.state.groups,
