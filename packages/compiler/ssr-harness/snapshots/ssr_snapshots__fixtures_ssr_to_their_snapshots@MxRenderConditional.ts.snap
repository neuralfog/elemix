import { Component } from '@neuralfog/elemix';

export class MxRenderConditional extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'mx-render-conditional'}><template shadowrootmode="open" shadowrootserializable=""><div class="when">`, ($__ssrWhen(
