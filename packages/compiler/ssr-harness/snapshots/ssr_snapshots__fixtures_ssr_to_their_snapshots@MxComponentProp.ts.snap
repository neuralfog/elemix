import { $__ssrChild, $__ssrTpl } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

import './MxCounterChild';

type State = { label: string; which: 'a' | 'b' };

export class MxComponentProp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'mx-component-prop'}><template shadowrootmode="open" shadowrootserializable=""><div class="wrap"><section class="host">`, (this.state.which === 'a'
                    ? $__ssrTpl($__ssrChild('mx-counter-child', {label: (this.state.label)}, undefined, ` class="slot-a"`))
