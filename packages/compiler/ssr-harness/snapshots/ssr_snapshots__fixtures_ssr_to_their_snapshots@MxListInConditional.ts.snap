import { $__ssrText, $__ssrAttr, $__ssrTpl, $__ssrRepeat } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

type Item = { id: number; label: string };
type State = { show: boolean; items: Item[] };

export class MxListInConditional extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'mx-list-in-conditional'}><template shadowrootmode="open" shadowrootserializable=""><div class="wrap"><section class="host">`, (this.state.show
                    ? $__ssrTpl(`<ul class="list">`, ($__ssrRepeat(
                          this.state.items,
                          (it) =>
