$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'when-else-app'}><template shadowrootmode="open" shadowrootserializable=""><div class="stage">`, ($__ssrWhen(
                    this.state.loggedIn,
                    () => $__ssrTpl(`<div class="card ready">✓ Welcome back</div>`),
                    () => $__ssrTpl(`<div class="card idle">Please log in</div>`),
                )), `</div><button class="toggle">toggle</button></template></${this.$$__tag ?? 'when-else-app'}>`];
}
