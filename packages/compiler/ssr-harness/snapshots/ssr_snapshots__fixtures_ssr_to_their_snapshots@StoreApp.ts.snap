        background: #e2e8f0;
        padding: 1px 5px;
        border-radius: 4px;
    }
    .readout { margin-bottom: 16px; font-size: 15px; }
    .readout strong { font-size: 22px; color: var(--accent); }
`;

export class StoreApp extends Component {
