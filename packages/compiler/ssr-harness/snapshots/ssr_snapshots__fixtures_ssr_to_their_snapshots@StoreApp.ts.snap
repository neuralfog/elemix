return [`<${this.$$__tag ?? 'store-app'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><div class="readout">Parent reads: <strong>`, $__ssrText(this.state.counter.value), `</strong></div>`, $__ssrChild('store-controls', {counter: (this.state.counter)}), `</template></${this.$$__tag ?? 'store-app'}>`];
}


    state = $__state<State>({
        counter: { value: 0 },
    });

    
}
$__defineComponent('store-app', StoreApp);
StoreApp.prototype.$$__tag = 'store-app';
StoreApp.$$__propSafe = true;
