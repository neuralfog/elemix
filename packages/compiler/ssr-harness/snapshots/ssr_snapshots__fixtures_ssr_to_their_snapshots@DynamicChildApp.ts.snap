import { $__ssrText, $__ssrAttr, $__ssrTpl, $__ssrRepeat } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component } from '@neuralfog/elemix';

type Item = { id: string; icon: () => Template };

const items: Item[] = [
    { id: 'a', icon: () => $__ssrTpl(`<i class="icon icon-a"></i>`) },
    { id: 'b', icon: () => $__ssrTpl(`<i class="icon icon-b"></i>`) },
];

const badge = (): Template => $__ssrTpl(`<b class="badge">NEW</b>`);

type State = { fancy: boolean };

export class DynamicChildApp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'dynamic-child-app'}><template shadowrootmode="open" shadowrootserializable=""><div class="icons">`, ($__ssrRepeat(
                    items,
                    (it) =>
                        $__ssrTpl(`<span class="row"${$__ssrAttr('data-id', it.id)}>`, $__ssrText(it.icon()), `</span>`),
                    (it) => it.id,
                )), `</div><div class="swap">`, $__ssrText(this.pick), `</div><button class="toggle">toggle</button></template></${this.$$__tag ?? 'dynamic-child-app'}>`];
}

    state = $__state<State>({ fancy: false });

    private get pick(): string | Template {
        return this.state.fancy ? badge() : 'plain';
    }

    toggle = (): void => {
        this.state.fancy = !this.state.fancy;
    };

    
}
$__defineComponent('dynamic-child-app', DynamicChildApp);
DynamicChildApp.prototype.$$__tag = 'dynamic-child-app';
DynamicChildApp.$$__propSafe = true;
