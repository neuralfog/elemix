return [`<${this.$$__tag ?? 'ui-stepper'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><div class="stepper"><button>−</button><span class="count">`, $__ssrText(this.state.count), `</span><button>+</button></div></template></${this.$$__tag ?? 'ui-stepper'}>`];
}

    state = $__state<State>({ count: 0 });

