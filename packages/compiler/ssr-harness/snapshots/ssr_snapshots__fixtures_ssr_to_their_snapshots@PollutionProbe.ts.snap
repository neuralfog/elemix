return [`<${this.$$__tag ?? 'pollution-probe'}><template shadowrootmode="open" shadowrootserializable=""><span class="pollution">`, $__ssrText(this.check()), `</span></template></${this.$$__tag ?? 'pollution-probe'}>`];
