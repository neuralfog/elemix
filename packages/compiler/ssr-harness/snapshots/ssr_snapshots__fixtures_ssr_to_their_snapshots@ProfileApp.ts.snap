import { $__ssrAttr, $__ssrChild } from '@neuralfog/elemix/ssr-runtime';
import { $__defineComponent, $__state } from '@neuralfog/elemix/runtime';
import { Component, ref } from '@neuralfog/elemix';
import type { Ref } from '@neuralfog/elemix/types';

import './ProfileCard';

type State = {
    name: Ref<string>;
    role: Ref<string>;
    likes: number;
};

const css = `
    :host { --accent: #6366f1; display: block; font-family: system-ui, sans-serif; }
    .controls {
        display: flex; flex-wrap: wrap; gap: 12px;
        align-items: flex-end; margin-bottom: 20px;
    }
    label {
        display: flex; flex-direction: column; gap: 4px;
        font-size: 12px; color: #64748b;
    }
    input {
        font: inherit; font-size: 14px; padding: 7px 10px;
        border: 1px solid #cbd5e1; border-radius: 8px; outline: none;
    }
    input:focus { border-color: var(--accent); }
    button {
        font: inherit; padding: 8px 14px; border: none; border-radius: 8px;
        background: var(--accent); color: white; cursor: pointer;
    }
    button:hover { background: #4f46e5; }
`;

export class ProfileApp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'profile-app'}><template shadowrootmode="open" shadowrootserializable=""><style data-ssr>${css}</style><div class="controls"><label>Name <input type="text"${$__ssrAttr('value', (this.state.name).value)}/></label><label>Role <input type="text"${$__ssrAttr('value', (this.state.role).value)}/></label><button>👍 Like</button></div>`, $__ssrChild('profile-card', {name: (this.state.name.value), role: (this.state.role.value), likes: (this.state.likes)}), `</template></${this.$$__tag ?? 'profile-app'}>`];
}


    state = $__state<State>({
        name: ref('Ada Lovelace'),
        role: ref('Engineer'),
        likes: 0,
    });

    like = (): void => {
        this.state.likes++;
    };

    
}
$__defineComponent('profile-app', ProfileApp);
ProfileApp.prototype.$$__tag = 'profile-app';
ProfileApp.$$__propSafe = true;
