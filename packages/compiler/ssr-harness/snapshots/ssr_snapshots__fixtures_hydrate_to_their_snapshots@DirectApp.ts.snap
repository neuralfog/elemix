        border-radius: 8px;
    }
    code {
        font-family: ui-monospace, monospace;
        font-size: 12px;
        background: #e2e8f0;
        padding: 1px 5px;
        border-radius: 4px;
    }
    .box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 140px;
        height: 80px;
        margin-bottom: 14px;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        background: #e2e8f0;
        transition: all 0.2s ease;
    }
    .box.active { background: var(--accent); color: white; }
    .box.rounded { border-radius: 18px; }
