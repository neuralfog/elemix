    .action {
        font: inherit;
        padding: 9px 18px;
        border: none;
        border-radius: 8px;
        background: var(--accent);
        color: white;
        cursor: pointer;
    }
    .action:hover:not(:disabled) { background: #4f46e5; }
    .action:disabled { opacity: 0.5; cursor: not-allowed; }
`;

