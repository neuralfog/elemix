import { Component } from '@neuralfog/elemix';

type State = {
    count: number;
};

export class EffectApp extends Component {
$$__ssr(): unknown[] {
return [`<${this.$$__tag ?? 'effect-app'}><template shadowrootmode="open" shadowrootserializable=""><div class="effect"><span class="count">`, $__ssrText(this.state.count), `</span><button class="inc">+1</button></div></template></${this.$$__tag ?? 'effect-app'}>`];
