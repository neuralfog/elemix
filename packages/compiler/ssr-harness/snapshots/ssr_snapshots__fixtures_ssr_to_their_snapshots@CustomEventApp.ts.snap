return [`<${this.$$__tag ?? 'custom-event-app'}><template shadowrootmode="open" shadowrootserializable=""><button class="fire">fire</button><span class="caught">`, $__ssrText(this.state.caught), `</span></template></${this.$$__tag ?? 'custom-event-app'}>`];
