throw new Error('[elemix] module-level `#state` must be an object - a bare primitive export can\'t be reactive. Wrap it in a store object, e.g. `export const store = { count: 0 };` and read `store.count`. (Bare primitives are reactive only as component class fields.)');
import { $__state } from '@neuralfog/elemix/runtime';
export const count = $__state(0);
