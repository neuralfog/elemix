{
    "name": "@neuralfog/elemix-template-formatter",
    "version": "0.9.5",
    "private": true,
    "type": "module",
    "bin": {
        "etf": "bin/elemix-template-formatter.mjs",
        "elemix-template-formatter": "bin/elemix-template-formatter.mjs"
    },
    "scripts": {
        "build": "ELEMIX_VERSION=$npm_package_version cargo build --release",
        "lint": "cargo clippy --all-targets -- -D warnings && cargo fmt --check",
        "lint:fix": "cargo clippy --all-targets --fix --allow-dirty --allow-staged && cargo fmt",
        "test": "cargo test"
    }
}
