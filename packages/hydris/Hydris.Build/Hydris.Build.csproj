<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hydris.Build</RootNamespace>
    <AssemblyName>Hydris.Build</AssemblyName>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hydris-build</ToolCommandName>
    <PackageId>Hydris.Build</PackageId>
    <Description>View build tool for Hydris and elemix SSR.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hydris.QuickJs/Hydris.QuickJs.csproj" />
    <InternalsVisibleTo Include="Hydris.Tests" />
  </ItemGroup>

</Project>
