// <auto-generated />

import { reactive, csrf } from '@neuralfog/elemix';
import type { ActionState, FieldError } from './index';
import { ActionErrorKind, Method } from './index';

export type CreateReq = {
    name: string;
    age: number;
};

export type Echo = {
    value: string;
};

export type CreateAction = ActionState<Echo> & {
    run(body: CreateReq): Promise<void>;
};

export const create = (): CreateAction => {
    let controller: AbortController | null = null;
    return reactive<CreateAction>({
        data: null,
        loading: false,
        isError: false,
        error: null,
        async run(body: CreateReq): Promise<void> {
            controller?.abort();
            controller = new AbortController();
            const signal = controller.signal;
            this.data = null;
            this.error = null;
            this.isError = false;
            this.loading = true;
            try {
                const response = await fetch('/api/items', {
                    method: Method.Post,
                    headers: { 'Content-Type': 'application/json', 'X-Hydris-Csrf': csrf() },
                    body: JSON.stringify(body),
                    signal,
                });
                if (response.ok) {
                    this.data = (await response.json()) as Echo;
                } else if (response.status === 400) {
                    const problem = (await response.json()) as {
                        errors: FieldError[];
                    };
                    this.error = {
                        kind: ActionErrorKind.Validation,
                        errors: problem.errors,
                    };
                    this.isError = true;
                } else {
                    this.error = {
                        kind: ActionErrorKind.Http,
                        status: response.status,
                    };
                    this.isError = true;
                }
            } catch {
                if (signal.aborted) return;
                this.error = { kind: ActionErrorKind.Network };
                this.isError = true;
            } finally {
                if (!signal.aborted) this.loading = false;
            }
        },
    });
};
