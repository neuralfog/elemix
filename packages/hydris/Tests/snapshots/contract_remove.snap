// <auto-generated />

import { reactive, csrf } from '@neuralfog/elemix';
import type { ActionState, FieldError } from './index';
import { ActionErrorKind, Method } from './index';

export type Echo = {
    value: string;
};

export type RemoveArgs = { id: string };

export type RemoveAction = ActionState<Echo> & {
    run(args: RemoveArgs): Promise<void>;
};

export const remove = (): RemoveAction => {
    let controller: AbortController | null = null;
    return reactive<RemoveAction>({
        data: null,
        loading: false,
        isError: false,
        error: null,
        async run(args: RemoveArgs): Promise<void> {
            controller?.abort();
            controller = new AbortController();
            const signal = controller.signal;
            this.data = null;
            this.error = null;
            this.isError = false;
            this.loading = true;
            try {
                const url = `/api/items/${encodeURIComponent(String(args.id))}`;
                const response = await fetch(url, {
                    method: Method.Delete,
                    headers: { 'X-Hydris-Csrf': csrf() },
                    signal,
                });
                if (response.ok) {
                    this.data = (await response.json()) as Echo;
                } else if (response.status === 400) {
                    const problem = (await response.json()) as {
                        errors: FieldError[];
                    };
                    this.error = {
                        kind: ActionErrorKind.Validation,
                        errors: problem.errors,
                    };
                    this.isError = true;
                } else {
                    this.error = {
                        kind: ActionErrorKind.Http,
                        status: response.status,
                    };
                    this.isError = true;
                }
            } catch {
                if (signal.aborted) return;
                this.error = { kind: ActionErrorKind.Network };
                this.isError = true;
            } finally {
                if (!signal.aborted) this.loading = false;
            }
        },
    });
};
