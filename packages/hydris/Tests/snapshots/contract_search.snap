// <auto-generated />

import { reactive } from '@neuralfog/elemix';
import type { ActionState, FieldError } from './index';
import { ActionErrorKind, Method, setParam } from './index';

export type Echo = {
    value: string;
};

export type SearchArgs = { q?: string; page: number };

export type SearchAction = ActionState<Echo> & {
    run(args: SearchArgs): Promise<void>;
};

export const search = (): SearchAction => {
    let controller: AbortController | null = null;
    return reactive<SearchAction>({
        data: null,
        loading: false,
        isError: false,
        error: null,
        async run(args: SearchArgs): Promise<void> {
            controller?.abort();
            controller = new AbortController();
            const signal = controller.signal;
            this.data = null;
            this.error = null;
            this.isError = false;
            this.loading = true;
            try {
                const url = `/api/search`;
                const query = new URLSearchParams();
                setParam(query, 'q', args.q);
                setParam(query, 'page', args.page);
                const target = query.size ? `${url}?${query.toString()}` : url;
                const response = await fetch(target, {
                    method: Method.Get,
                    signal,
                });
                if (response.ok) {
                    this.data = (await response.json()) as Echo;
                } else if (response.status === 400) {
                    const problem = (await response.json()) as {
                        errors: FieldError[];
                    };
                    this.error = {
                        kind: ActionErrorKind.Validation,
                        errors: problem.errors,
                    };
                    this.isError = true;
                } else {
                    this.error = {
                        kind: ActionErrorKind.Http,
                        status: response.status,
                    };
                    this.isError = true;
                }
            } catch {
                if (signal.aborted) return;
                this.error = { kind: ActionErrorKind.Network };
                this.isError = true;
            } finally {
                if (!signal.aborted) this.loading = false;
            }
        },
    });
};
