<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hydris</RootNamespace>
    <AssemblyName>Hydris</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hydris.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Renderer/sidecar.ts">
      <LogicalName>Hydris.Renderer.sidecar.ts</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
