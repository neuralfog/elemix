<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Hydris</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Hydris/**/*.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Hydris.Generators/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Hydris/Hydris.csproj" />
    <ProjectReference Include="Hydris.Generators/Hydris.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
